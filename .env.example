# LLM (에이전트 두뇌) — tool calling 지원 모델
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4.1

# 데이터 소스 — F1_XR_Server 경유가 기본.
# F1_SERVER_URL 을 채우면 서버의 /f1/... (캐시된 과거 경기)에서 데이터를 받는다.
# (라이브 세션 중 OpenF1 401 게이트의 영향을 받지 않음)
F1_SERVER_URL=http://localhost:8000

# F1_SERVER_URL 이 비어 있을 때만 쓰이는 직결 폴백 주소
OPENF1_BASE=https://api.openf1.org/v1

# 기본 데모 세션(모나코 2024 Race = 9523)
DEFAULT_SESSION_KEY=9523
